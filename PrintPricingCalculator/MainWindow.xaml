<Window x:Class="PrintPricingCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Print Pricing Calculator" Height="850" Width="1350" 
        WindowStartupLocation="CenterScreen"
        Icon="PricingAppInstaller.ico" Background="{DynamicResource AppBackground}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CardBackground" Color="#252526"/>
        <SolidColorBrush x:Key="PrimaryText" Color="White"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#CCCCCC"/>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="4" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource SecondaryText}" 
                                                        CornerRadius="5" 
                                                        Margin="2,0,2,0"
                                                        Opacity="0.6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15" TextBox.TextChanged="Input_TextChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,5,10,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="GitHubLogo_Click" 
                ToolTip="View Source Code on GitHub">

                <Canvas Width="80" Height="80" Margin="0,0,15,0" VerticalAlignment="Center">
                    <Polygon Points="40,10 66,25 66,55 40,70 14,55 14,25" 
                     Stroke="#D83B01" StrokeThickness="6" StrokeLineJoin="Round" Fill="Transparent"/>
                    <Polyline Points="14,25 40,40 66,25" 
                      Stroke="#D83B01" StrokeThickness="6" StrokeLineJoin="Round" 
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                    <Line X1="40" Y1="40" X2="40" Y2="70" 
                  Stroke="#D83B01" StrokeThickness="6" 
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Precision Cost Calculator for 3D Printing" 
                       FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI"/>

                    <TextBlock Text="Maximizing profits with effortless accuracy." 
                       FontSize="14" Foreground="{DynamicResource PrimaryText}" Opacity="0.8" FontFamily="Segoe UI" Margin="0,2,0,0"/>

                    <TextBlock x:Name="lblSubtitle" Text="Your ultimate 3D print quote wizard" 
                       FontSize="12" Foreground="{DynamicResource PrimaryText}" Opacity="0.5" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <CheckBox x:Name="chkDarkMode" Content="🌙 Dark Mode" 
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,0,0" 
              FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" 
              Click="DarkMode_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Expander x:Name="expAdvanced" Header="⚙️ Shop &amp; Machine Settings" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="18" IsExpanded="False">
                        <StackPanel Margin="-15,10,15,0">
                            <TextBlock Text="Material Efficiency Factor ❓" Foreground="{DynamicResource SecondaryText}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="250" Background="#333" Foreground="White">
                                        <TextBlock TextWrapping="Wrap" Text="Buffer for purged plastic, failed prints, and supports. (1.10 = +10%)"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox x:Name="txtEfficiency" Text="1.10"/>

                            <TextBlock Text="Labor Hourly Rate ($/hr)" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtLaborRate" Text="20.0"/>

                            <TextBlock Text="Printer Cost ($)" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtPrinterCost" Text="1000"/>

                            <TextBlock Text="Est. Annual Maintenance ($)" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtMaintenance" Text="75"/>

                            <TextBlock Text="Estimated Life (yrs)" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtLife" Text="3"/>

                            <TextBlock Text="Estimated Uptime (%)" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtUptime" Text="50"/>

                            <TextBlock Text="Printer Power (W)" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtPower" Text="150"/>

                            <TextBlock Text="Electricity Cost ($/KWh)" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtElecCost" Text="0.14"/>

                            <TextBlock Text="Printer Cost Buffer Factor ❓" Foreground="{DynamicResource SecondaryText}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="250" Background="#333" Foreground="White">
                                        <TextBlock TextWrapping="Wrap" Text="Buffer for hidden maintenance. (1.30 = +30%)"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox x:Name="txtBuffer" Text="1.3"/>

                            <Separator Background="#444" Margin="0,10,0,10"/>
                            <TextBlock Text="📜 Licensing &amp; Model Costs" FontSize="15" FontWeight="Bold" Foreground="#D83B01" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Cost ($) ❓" Foreground="{DynamicResource SecondaryText}" Cursor="Help">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="250" Background="#333" Foreground="White">
                                                <TextBlock TextWrapping="Wrap" Text="Patreon sub fee, or a one-off STL purchase."/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBox x:Name="txtLicenseCost" Text="0.00"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Creator Name" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBox x:Name="txtCreatorName" Text="Unknown"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Expected Sales ❓" Foreground="{DynamicResource SecondaryText}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="250" Background="#333" Foreground="White">
                                        <TextBlock TextWrapping="Wrap" Text="Set to 1 for a one-off print. Set higher to spread a sub cost across multiple prints."/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox x:Name="txtExpectedSales" Text="1"/>

                            <Button Content="💾 Save Settings as Default" Height="30" Padding="20,0,20,0" Margin="0,15,0,5" 
                                    HorizontalAlignment="Center" Background="#4A4A4A" Foreground="White" 
                                    FontWeight="Bold" BorderThickness="0" Click="SaveDefaults_Click" Cursor="Hand"
                                    ToolTip="Save these settings to load automatically next time you open the app"/>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="🖨️ Core Print Details" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,15"/>

                        <TextBlock Text="Filament Cost ($/kg)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtFilamentCost" Text="20.0"/>

                        <TextBlock Text="Total Filament Required (g)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtFilamentReq" Text="150"/>

                        <TextBlock Text="Total Printing Time (hr)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtPrintTime" Text="5.0"/>

                        <TextBlock Text="Total Labor Required (min)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtLaborTime" Text="15"/>

                        <TextBlock Text="Total Extra Hardware Cost ($)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtHardwareCost" Text="0.00"/>

                        <TextBlock Text="Total Packaging Cost ($)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtPackagingCost" Text="1.50"/>

                        <TextBlock Text="Postage/Shipping ($)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtPostage" Text="4.00"/>

                        <TextBlock Text="Tax Rate (%)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="txtTaxRate" Text="0.0"/>

                        <TextBlock Text="Discount (%)" Foreground="#107C10" FontWeight="Bold"/>
                        <TextBox x:Name="txtDiscount" Text="0.0" BorderBrush="#107C10" BorderThickness="2"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="📊 Final Pricing" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Materials:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="lblMaterialsCost" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Labor:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="lblLaborCost" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Machine Wear:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="lblMachineCost" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tax:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="lblTaxCost" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Background="#D83B01" CornerRadius="8" Padding="15" Margin="0,5,0,15">
                                <StackPanel>
                                    <TextBlock Text="Total Landed Cost:" Foreground="#FAD8CC" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="lblLandedCost" Text="$0.00" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Select Margin for Customer Quote:" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <RadioButton x:Name="rbMargin40" GroupName="Margins" Content="40% Margin:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left" Checked="Input_TextChanged"/>
                                <TextBlock x:Name="lblMargin40" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <RadioButton x:Name="rbMargin50" GroupName="Margins" Content="50% Margin:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left" IsChecked="True" Checked="Input_TextChanged"/>
                                <TextBlock x:Name="lblMargin50" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <RadioButton x:Name="rbMargin60" GroupName="Margins" Content="60% Margin:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left" Checked="Input_TextChanged"/>
                                <TextBlock x:Name="lblMargin60" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <RadioButton x:Name="rbMargin70" GroupName="Margins" Content="70% Margin:" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left" Checked="Input_TextChanged"/>
                                <TextBlock x:Name="lblMargin70" Text="$0.00" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Background="#107C10" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="Final Customer Quote:" Foreground="#DFF6DD" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="lblFinalQuotePrice" Text="$0.00" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="📁 Project File &amp; Quoting" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Quote # ❓" Foreground="{DynamicResource SecondaryText}" Cursor="Help">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="250" Background="#333" Foreground="White">
                                                <TextBlock TextWrapping="Wrap" Text="Bumps up by 1 automatically after printing a Customer copy."/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBox x:Name="txtQuoteNumber" Text="1001"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Customer Name" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBox x:Name="txtCustomerName" Text="Walk-in Customer"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Project / Part Name" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtFileName" Text="My Awesome Print"/>

                            <TextBlock Text="Designer / Shop Name" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="txtDesignerName" Text="Print Shop"/>

                            <TextBlock Text="Shop Logo (For Invoice Prints)" Foreground="{DynamicResource SecondaryText}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtLogoPath" Grid.Column="0" Margin="0,0,5,0" IsReadOnly="True" Text=""/>
                                <Button Grid.Column="1" Content="Browse" Width="70" Height="28" Background="#4A4A4A" Foreground="White" BorderThickness="0" Click="BrowseLogo_Click"/>
                            </Grid>

                            <Grid Margin="0,5,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="💾 Save Project" Height="30" Margin="0,0,5,0" Background="#107C10" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Save_Click"/>
                                <Button Grid.Column="1" Content="📂 Load Project" Height="30" Margin="5,0,0,0" Background="#0078D7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Load_Click"/>
                            </Grid>

                            <TextBlock Text="Print Output Type:" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="rbPrintCustomer" Content="Customer Quote" GroupName="PrintMode" IsChecked="True" Foreground="{DynamicResource SecondaryText}" Grid.Column="0"/>
                                <RadioButton x:Name="rbPrintInternal" Content="Internal Copy" GroupName="PrintMode" Foreground="{DynamicResource SecondaryText}" Grid.Column="1"/>
                            </Grid>

                            <Button Content="🖨️ Generate PDF" Height="34" Background="#D83B01" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Print_Click"/>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>